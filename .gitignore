# --- Terraform ---
**/.terraform/*
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfvars
*.tfvars.json
!example.tfvars
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
*.tfplan

# --- Rust ---
services/gateway-rs/target/
**/*.rs.bk

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.ipynb_checkpoints/

# --- Secrets & credentials ---
.env
.env.*
*.pem
*.key
kubeconfig*
!kubeconfig*.example
.aws/

# --- Editors / OS ---
.vscode/
.idea/
*.swp
.DS_Store

# --- Build artifacts ---
*.log
dist/

# --- Local-only working notes ---
CLAUDE.md
COMPLETE_PLAN.md

# Local reference docs, test documents & env tooling — never commit
*.docx
/*.pdf
.envrc

# --- Eval inputs and outputs (may contain real documents) ---
eval/**/data/
eval/**/runs/
